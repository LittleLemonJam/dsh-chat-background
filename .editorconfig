# https://editorconfig.org — 所有编辑器共用的基础格式约定。
# 与 .prettierrc.json 保持一致：2 空格缩进、LF、UTF-8、行尾无多余空白、文件末尾一个换行。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Markdown 有意保留行尾两个空格（换行）与长行表格：交给 Prettier 处理。
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.png]
insert_final_newline = false

[Makefile]
indent_style = tab
